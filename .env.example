# DISBank backend configuration (Phase 0.2 — config externalization).
#
# Every value below is OPTIONAL. The defaults shown reproduce the original
# local-dev behavior, so an existing `go run main.go -p 8080` works with no
# .env file at all. Copy this file to `.env` and edit as needed:
#
#   cp .env.example .env
#
# These are read from the process environment by internal/config/config.go.
# The Go binary does not auto-load a .env file; export the vars yourself, e.g.
#   set -a; source .env; set +a
# or pass them via your shell / docker compose `environment:` block.

# Comma-separated mongos router URI. On the host these are localhost ports;
# inside Docker this must use the router service names instead of localhost.
MONGO_URI=mongodb://localhost:27151,localhost:27152,localhost:27153

# Connection pool bounds (tune for benchmarks without a recompile).
MONGO_MAX_POOL=30000
MONGO_MIN_POOL=10

# Read preference for the shared client: primary | primaryPreferred |
# secondary | secondaryPreferred | nearest. Unknown values fall back to
# secondary. History reads currently rely on secondary/local for throughput.
MONGO_READ_PREF=secondary

# Port for the backend to listen on. The `-p` flag overrides this; if neither
# is set the server refuses to start. Leave unset to require an explicit -p.
PORT=8080

# Secret used to sign/verify JWTs (wired into config now; consumed in Phase 1.3).
# CHANGE THIS for any non-local use.
JWT_SECRET=dev-insecure-secret-change-me
